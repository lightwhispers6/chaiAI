# ===== QQ 邮箱 SMTP 配置 =====
# 你的 QQ 邮箱地址
QQ_SMTP_USER=annieannie0626@qq.com
# QQ 邮箱「设置 → 账户 → POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务」里生成的授权码
# 注意：是授权码，不是 QQ 密码！此文件不要提交到 git
QQ_SMTP_PASS=在这里填你的授权码

# 留言接收邮箱（默认 = QQ_SMTP_USER，即发给自己）
MAIL_TO=annieannie0626@qq.com

# 允许调用接口的前端来源，多个用英文逗号分隔
ALLOWED_ORIGINS=https://lightwhispers6.github.io,http://localhost:5173

# 服务端口（本地默认 3001，线上平台一般自动注入 PORT，无需设置）
PORT=3001
